% docker

# Remove an image
podman image rm <image_id>

# Delete an image from the local image store
podman rmi <image_id>

# Clean none/dangling images
podman rmi $(podman images --filter "dangling=true" -q --no-trunc)

# Force clean none/dangling images
podman rmi $(podman images --filter "dangling=true" -q --no-trunc) -f

# List all images that are locally stored with the podman engine
podman images

# Build an image from the Dockerfile in the current directory and tag the image
podman build -t <image>:<version> .

# Pull an image from a registry
podman pull <image>:<version>

# Stop a running container through SIGTERM
podman stop <container_id>

# Stop a running container through SIGKILL
podman kill <container_id>

# List the networks
podman network ls

# List the running containers
podman ps

# Delete all running and stopped containers
podman rm -f $(podman ps -aq)

# Create a new bash process inside the container and connect it to the terminal
podman exec -it <container_id> bash

# Print the last lines of a container's logs
podman logs --tail 100 <container_id> | less

# Print the last lines of a container's logs and following its logs
podman logs --tail 100 <container_id> -f

# Create new network
podman network create <network_name>

$ image_id: podman images --- --headers 1 --column 3
$ container_id: podman ps --- --headers 1 --column 1



% docker-compose

# Builds, (re)creates, starts, and attaches to containers for all services
podman-compose up

# Builds, (re)creates, starts, and dettaches to containers for all services
podman-compose up -d

# Builds, (re)creates, starts, and attaches to containers for a service
podman-compose up -d <service_name>

# Builds, (re)creates, starts, and dettaches to containers for a service
podman-compose up -d <service_name>

# Print the last lines of a service’s logs
podman-compose logs --tail 100 <service_name> | less

# Print the last lines of a service's logs and following its logs
podman-compose logs -f --tail 100 <service_name>

# Stops containers and removes containers, networks created by up
podman-compose down
