#!/usr/bin/env bash

if ! command -v tmux >/dev/null 2>&1; then
    exit 0
fi

list_sessions() {
    local format
    format=$'#{session_name}\t#{session_windows} windows\t#{?session_attached,attached,detached}'
    tmux list-sessions -F "$format" 2>/dev/null || true
}

show_message() {
    if [ -w /dev/tty ]; then
        printf '%s\n\nPress Enter to continue...' "$1" >/dev/tty
        IFS= read -r _ </dev/tty || true
    else
        printf '%s\n' "$1" >&2
    fi
}

trim_session_name() {
    local name="$1"
    name="${name#"${name%%[![:space:]]*}"}"
    name="${name%"${name##*[![:space:]]}"}"
    printf '%s' "$name"
}

create_session() {
    local name
    name="$(trim_session_name "${1:-}")"

    if [ -z "$name" ]; then
        show_message 'Type a session name in the query, then press Ctrl-N to create it.'
        return 0
    fi

    if [[ ! "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]; then
        show_message 'Invalid session name. Use letters, numbers, dots, underscores, or dashes.'
        return 0
    fi

    if tmux has-session -t "=$name" 2>/dev/null; then
        show_message "Session already exists: $name"
        return 0
    fi

    tmux new-session -d -s "$name"
}

kill_session() {
    local session="${1:-}"
    local answer

    if [ -z "$session" ]; then
        return 0
    fi

    if [ ! -w /dev/tty ]; then
        return 0
    fi

    printf "Kill tmux session '%s'? [y/N] " "$session" >/dev/tty
    IFS= read -r answer </dev/tty || return 0

    case "$answer" in
        [Yy]|[Yy][Ee][Ss]) tmux kill-session -t "=$session" ;;
    esac
}

case "${1:-}" in
    --list)
        list_sessions
        exit 0
        ;;
    --create)
        create_session "${2:-}"
        exit 0
        ;;
    --kill)
        kill_session "${2:-}"
        exit 0
        ;;
esac

if ! command -v fzf >/dev/null 2>&1; then
    exit 0
fi

script_path="${BASH_SOURCE[0]}"
script_cmd="$(printf '%q' "$script_path")"
list_cmd="$script_cmd --list"
create_cmd="$script_cmd --create"
kill_cmd="$script_cmd --kill"

selection="$(
    list_sessions | fzf \
        --prompt='tmux sessions> ' \
        --height=40% \
        --reverse \
        --border \
        --exit-0 \
        --delimiter=$'\t' \
        --header='Enter: switch/attach | Ctrl-N: create from query | Ctrl-D: kill | Ctrl-R: reload | Esc: cancel' \
        --bind "ctrl-n:execute($create_cmd {q})+reload($list_cmd)" \
        --bind "ctrl-d:execute($kill_cmd {1})+reload($list_cmd)" \
        --bind "ctrl-r:reload($list_cmd)"
)"

session="${selection%%$'\t'*}"

if [ -z "$session" ]; then
    exit 0
fi

if [ -n "${TMUX:-}" ] && tmux display-message -p '#{client_tty}' >/dev/null 2>&1; then
    tmux switch-client -t "=$session"
else
    unset TMUX
    exec tmux attach-session -t "=$session"
fi
