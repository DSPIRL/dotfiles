#!/usr/bin/env bash

set -euo pipefail

if [[ $# -lt 1 ]]; then
  printf 'Usage: %s [wallust run args...] IMAGE\n' "${0##*/}" >&2
  exit 64
fi

wallust run "$@"

if [[ "$OSTYPE" == linux* ]]; then
  pkill -USR2 -u "$UID" -x ghostty 2>/dev/null || true
fi

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [[ ! -d "$runtime_dir" || ! -w "$runtime_dir" ]]; then
  runtime_dir="${HOME}/.cache"
fi

signal_shell_sessions() {
  local shell_name="$1"
  local signal="$2"
  local pid_file="${runtime_dir}/wallust-prompt-refresh.${shell_name}.pids"
  local tmp_file pid start_time comm stat rest
  local -a stat_fields

  [[ -f "$pid_file" ]] || return 0

  tmp_file="$(mktemp "${pid_file}.XXXXXX")"

  while read -r pid start_time _; do
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    kill -0 "$pid" 2>/dev/null || continue

    if [[ -r "/proc/${pid}/comm" ]]; then
      read -r comm <"/proc/${pid}/comm" || continue
      [[ "$comm" == "$shell_name" ]] || continue
    fi

    if [[ -n "${start_time:-}" && -r "/proc/${pid}/stat" ]]; then
      stat="$(<"/proc/${pid}/stat")"
      rest="${stat#*) }"
      read -r -a stat_fields <<<"$rest"
      [[ "${stat_fields[19]:-}" == "$start_time" ]] || continue
    fi

    kill "-${signal}" "$pid" 2>/dev/null || continue
    printf '%s %s\n' "$pid" "${start_time:-}" >>"$tmp_file"
  done <"$pid_file"

  mv "$tmp_file" "$pid_file"
}

signal_shell_sessions zsh USR1
signal_shell_sessions fish USR2
