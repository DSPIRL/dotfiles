#!/usr/bin/env bash
set -euo pipefail

if (( $# == 0 )); then
    printf 'Usage: %s FILE_OR_DIRECTORY [...]\n' "${0##*/}" >&2
    printf 'Paths are interpreted relative to ~/files/qbittorrent_download on jellyfin.\n' >&2
    exit 2
fi

remote_command='"$HOME/scripts/copy_from_jellyfin"'
for argument in "$@"; do
    printf -v quoted '%q' "$argument"
    remote_command+=" $quoted"
done

exec ssh jellyfin "$remote_command"
