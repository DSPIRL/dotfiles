#!/usr/bin/env bash
set -eu

token=${1-}
search_root=.
query=$token

if [[ $token == */* ]]; then
  if [[ $token == */ ]]; then
    raw_root=${token%/}
    query=
  else
    raw_root=${token%/*}
    query=${token##*/}
  fi

  [[ -z $raw_root ]] && raw_root=/

  case $raw_root in
    '~') search_root=$HOME ;;
    '~/'*) search_root=${HOME}/${raw_root#~/} ;;
    *) search_root=$raw_root ;;
  esac

  if [[ ! -d $search_root ]]; then
    search_root=.
    query=$token
  fi
fi

if ! command -v tv >/dev/null 2>&1; then
  echo "tv-path-widget: television is not installed" >&2
  exit 1
fi

TV_SEARCH_ROOT="$search_root" \
  tv shell-paths --input "$query" --inline --no-status-bar </dev/tty
