{{- $isDarwin := eq .chezmoi.os "darwin" -}}
{{- $isLinux := eq .chezmoi.os "linux" -}}
{{- $isCachyOS := and $isLinux (dig "isCachyOS" false .) -}}

##### PRE ZSH #####
[[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/pre.zsh" ]] && \
  source "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/pre.zsh"

##### FZF #####
if command -v fzf &>/dev/null; then
  # Set up fzf key bindings and fuzzy completion
  export FZF_DEFAULT_OPTS_FILE="${HOME}/.config/fzf/.fzfrc"
  # export FZF_DEFAULT_OPTS="--style full --height 80% --popup center,40% --layout reverse --border top --extended --multi --preview 'cat {}'"
  export FZF_CTRL_T_OPTS="--preview='less {}' --bind shift-up:preview-page-up,shift-down:preview-page-down"
  export FZF_CTRL_T_COMMAND="fd --hidden --ignore-case"
  export FZF_ALT_C_COMMAND=""

  source <(fzf --zsh)
fi

##### ZOXIDE #####
if command -v zoxide &>/dev/null; then
  eval "$(zoxide init zsh)"
  export _ZO_DATA_DIR="${HOME}/.config/zoxide"
  export _ZO_ECHO=1
fi

##### COMPLETIONS #####
{{- if $isDarwin }}
if type brew &>/dev/null; then
  FPATH="$(brew --prefix)/share/zsh/site-functions:${FPATH}"
fi
{{- end }}
if [[ -d "${HOME}/.shell/zsh/completers" ]]; then
  FPATH="${HOME}/.shell/zsh/completers:${FPATH}"
fi
autoload -Uz compinit && compinit

{{- if $isDarwin }}
if command -v kubectl &>/dev/null; then
  source <(kubectl completion zsh)
fi

if command -v podman &>/dev/null; then
  source <(podman completion zsh)
fi

# These lines cause issues in ZSH
# if command -v rustup &>/dev/null; then
#   source <(rustup completions zsh)
#   source <(rustup completions zsh cargo)
# fi

if command -v dotnet &>/dev/null; then
  _dotnet_zsh_complete() {
    local completions=("$(dotnet complete --position ${CURSOR} "${LBUFFER}")")
    reply=( "${(ps:\n:)completions}" )
  }
  compctl -K _dotnet_zsh_complete dotnet
fi
{{- end }}

if command -v carapace &>/dev/null; then
  export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
  source <(carapace _carapace)
  zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
fi

if command -v chezmoi &>/dev/null; then
  eval "$(chezmoi completion zsh)"
fi

# FZF key bindings and completions
# [[ -f /usr/share/fzf/key-bindings.zsh ]] && source /usr/share/fzf/key-bindings.zsh
# [[ -f /usr/share/fzf/completion.zsh ]] && source /usr/share/fzf/completion.zsh

##### PROMPT #####
if command -v oh-my-posh &>/dev/null && [ "${TERM_PROGRAM}" != "Apple_Terminal" ]; then
  eval "$(oh-my-posh init zsh --config ${HOME}/.config/oh-my-posh/default.omp.json)"
fi

##### MISE-EN-PLACE #####
if command -v mise &>/dev/null; then
    eval "$(mise activate zsh)"
fi

##### KEYBINDS #####
bindkey -e                        # Force emacs key bindings (EDITOR/VISUAL containing 'vi' triggers vi mode)
autoload -U edit-command-line
zle -N edit-command-line
bindkey '^O' edit-command-line

##### ZSH PLUGINS #####
{{- if $isDarwin }}
[[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && \
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && \
  source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
{{- else if $isLinux }}
[[ -f /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && \
  source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ -f /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && \
  source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
{{- end }}

##### ZSH OPTIONS #####
setopt CORRECT            # Suggest corrections for mistyped commands
setopt AUTO_PUSHD         # Push old directory onto stack on cd
setopt PUSHD_IGNORE_DUPS  # Don't push duplicate directories onto stack

##### HISTORY #####
HISTFILE="${HOME}/.zhistory"
SAVEHIST=10000
HISTSIZE=10000
setopt share_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_verify

{{- if $isDarwin }}

##### DART COMPLETION (macOS) #####
[[ -f "${HOME}/.config/.dart-cli-completion/zsh-config.zsh" ]] && . "${HOME}/.config/.dart-cli-completion/zsh-config.zsh" || true


{{- else if $isLinux }}

##### SYNCTHING COMPLETION (Linux) #####
if [[ -f /usr/bin/syncthing ]]; then
  autoload -U +X bashcompinit && bashcompinit
  complete -C /usr/bin/syncthing syncthing
fi

{{- end }}

##### SOURCE SHELL FILES #####
source "${HOME}/.shell/aliases.sh"
source "${HOME}/.shell/functions.sh"

##### NVIM #####
# Switch between named Neovim configs
nvim-env() {
  NVIM_APPNAME="${1:-nvim}" nvim "${@:2}"
}

# Tab completion for nvim-env
_nvim_env_complete() {
  local configs
  configs=(~/.config/nvim*(/:t))
  _describe 'nvim configs' configs
}

compdef _nvim_env_complete nvim-env

##### SOURCE ZSH SNIPPETS #####
for zshrc_file in "${XDG_CONFIG_HOME:-$HOME/.config}"/zsh/rc.d/*.zsh(N); do
  source "${zshrc_file}"
done
unset zshrc_file
