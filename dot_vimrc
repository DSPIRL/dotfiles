filetype on
syntax enable
:set autoindent
:set expandtab
:set hlsearch
:set ignorecase
:set mouse=a
:set number relativenumber
:set scrolloff=999
:set showmatch
:set showmode
:set smartcase
:set wrap
:set smartindent
:set smarttab
:set softtabstop=4
:set tabstop=4
:set shiftwidth=4

" MACOS and WINDOWS
" :set clipboard=unnamed
" LINUX
" :set clipboard=unnamedplus

