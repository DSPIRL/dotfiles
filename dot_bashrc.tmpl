{{- $isDarwin := eq .chezmoi.os "darwin" -}}
{{- $isLinux := eq .chezmoi.os "linux" -}}
# If not running interactively, don't do anything
[[ $- != *i* ]] && return

source "${HOME}/.shell/aliases.sh"

if command -v nvim >/dev/null 2>&1; then
    nvim-env() {
        # Usage:
        # nvim-env nvim-scratch
        # nvim-env nvim-lazy    # another test config
        NVIM_APPNAME="$1" nvim "${@:2}"
    }

    # Tab completion for nvim-env
    _nvim_env_complete() {
        local cur="${COMP_WORDS[COMP_CWORD]}"
        local configs
        configs=$(ls ~/.config | grep nvim)
        COMPREPLY=($(compgen -W "$configs" -- "$cur"))
    }
    complete -F _nvim_env_complete nvim-env
fi

{{- if .isWSL }}

##### WSL CONFIGURATION #####
# don't put duplicate lines or lines starting with space in the history
HISTCONTROL=ignoreboth

# append to the history file, don't overwrite it
shopt -s histappend

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=1000
HISTFILESIZE=2000

# check the window size after each command
shopt -s checkwinsize

# make less more friendly for non-text input files
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# set variable identifying the chroot you work in (used in the prompt below)
source "${HOME}/.shell/aliases.sh"

if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# set a fancy prompt (non-color, unless we know we "want" color)
case "$TERM" in
xterm-color | *-256color) color_prompt=yes ;;
esac

if [ "$color_prompt" = yes ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt

# If this is an xterm set the title to user@host:dir
case "$TERM" in
xterm* | rxvt*)
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
    ;;
esac

# enable color support of ls
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# enable programmable completion features
if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        . /etc/bash_completion
    fi
fi

{{- else }}

##### PODMAN #####
if command -v podman &>/dev/null; then
    export DOCKER_HOST=unix://${XDG_RUNTIME_DIR}/podman/podman.sock
fi

##### FZF #####
if command -v fzf &>/dev/null; then
    export FZF_DEFAULT_OPTS="--extended --multi --preview 'cat {}'"
    # Let Television own Ctrl+T.
    export FZF_CTRL_T_COMMAND=""
    export FZF_CTRL_T_OPTS="--preview='less {}' --bind shift-up:preview-page-up,shift-down:preview-page-down"
fi

##### TELEVISION #####
if command -v tv &>/dev/null; then
    __tv_path_widget() {
        local original_line original_point before after token prefix selected quoted selection replacement
        original_line=$READLINE_LINE
        original_point=$READLINE_POINT
        before=${READLINE_LINE:0:READLINE_POINT}
        after=${READLINE_LINE:READLINE_POINT}
        token=${before##*[[:space:]]}
        prefix=${before:0:${#before}-${#token}}
        selected=$("${HOME}/.local/scripts/tv-path-widget" "$token") || selected=
        if [[ -z $selected ]]; then
            READLINE_LINE=$original_line
            READLINE_POINT=$original_point
            return
        fi

        quoted=()
        while IFS= read -r selection; do
            printf -v selection '%q' "$selection"
            quoted+=("$selection")
        done <<< "$selected"

        replacement=${quoted[*]}
        READLINE_LINE="${prefix}${replacement}${after}"
        READLINE_POINT=$((${#prefix} + ${#replacement}))
    }

    bind -x '"\C-t":__tv_path_widget'

    if command -v carapace &>/dev/null; then
        __tv_carapace_widget() {
            local original_line original_point before after token prefix output nospace selection quoted replacement
            local completion_line command_name alias_expansion seen_aliases alias_depth
            original_line=$READLINE_LINE
            original_point=$READLINE_POINT
            before=${READLINE_LINE:0:READLINE_POINT}
            after=${READLINE_LINE:READLINE_POINT}
            token=${before##*[[:space:]]}
            prefix=${before:0:${#before}-${#token}}
            [[ -n ${before//[[:space:]]/} ]] || return

            completion_line=${before#"${before%%[![:space:]]*}"}
            seen_aliases=" "
            for ((alias_depth = 0; alias_depth < 8; alias_depth++)); do
                command_name=${completion_line%%[[:space:]]*}
                [[ -n $command_name && $seen_aliases != *" $command_name "* ]] || break
                alias_expansion=${BASH_ALIASES[$command_name]-}
                [[ -n $alias_expansion ]] || break
                seen_aliases+="$command_name "
                completion_line="${alias_expansion}${completion_line#"$command_name"}"
            done

            output=$(
                COMP_LINE="$completion_line" \
                COMP_POINT=${#completion_line} \
                CARAPACE_SHELL=bash \
                CARAPACE_SHELL_ALIASES="$(compgen -a)" \
                CARAPACE_SHELL_BUILTINS="$(compgen -b)" \
                CARAPACE_SHELL_FUNCTIONS="$(compgen -A function)" \
                CARAPACE_SHELL_VARIABLES="$(compgen -v)" \
                "${HOME}/.local/scripts/tv-carapace-completion" "$completion_line" "$token"
            ) || output=
            if [[ $output != *$'\001'* ]]; then
                READLINE_LINE=$original_line
                READLINE_POINT=$original_point
                return
            fi

            nospace=${output%%$'\001'*}
            selection=${output#*$'\001'}
            selection=${selection%%$'\n'*}
            if [[ -z $selection ]]; then
                READLINE_LINE=$original_line
                READLINE_POINT=$original_point
                return
            fi

            printf -v quoted '%q' "$selection"
            replacement=$quoted
            [[ $nospace == true || -n $after ]] || replacement+=" "

            READLINE_LINE="${prefix}${replacement}${after}"
            READLINE_POINT=$((${#prefix} + ${#replacement}))
        }

        bind -x '"\C-@":__tv_carapace_widget'
    fi
fi

##### ZOXIDE #####
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init bash)"
    export _ZO_DATA_DIR="${HOME}/.config/zoxide"
    export _ZO_ECHO=1
fi

##### SHELL PROMPT #####
PS1='[\u@\h \W]\$ '

##### OH MY POSH PROMPT #####
if command -v oh-my-posh &>/dev/null; then
{{- if $isDarwin }}
    omp_config="${HOME}/.config/oh-my-posh/spaceship.omp.json"
{{- else if $isLinux }}
    omp_config="${HOME}/.config/oh-my-posh/wallust.omp.json"
{{- else }}
    omp_config=""
{{- end }}
    if [[ -n "${omp_config}" && -f "${omp_config}" ]]; then
        eval "$(oh-my-posh init bash --config "${omp_config}")"
    else
        eval "$(oh-my-posh init bash)"
    fi
    unset omp_config
fi

##### COMPLETERS #####
if command -v mise &>/dev/null; then
    source <(mise completion bash)
fi

if command -v carapace &>/dev/null; then
    export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
    source <(carapace _carapace)
fi

# AWSM
if command -v awsm &>/dev/null; then
    source <(awsm completions bash)
fi

# WALLI
if command -v walli &>/dev/null; then
    source <(walli completions bash)
fi

##### WORKTRUNK #####
if command -v wt >/dev/null 2>&1; then
    eval "$(command wt config shell init bash)";
fi

if command -v chezmoi &>/dev/null; then
    eval "$(chezmoi completion bash)"
fi

##### KEYBINDS #####
if command -v navi &>/dev/null; then
    # Navi defaults to Ctrl+G; preserve Emacs abort and use Ctrl+J instead.
    eval "$(navi widget bash)"
    bind '"\C-g": abort'
    bind -x '"\C-j": _navi_widget'
fi

# Bind Ctrl+O to edit command in vim
bind '"\C-o": edit-and-execute-command'

if command -v fzf &>/dev/null && command -v tmux &>/dev/null; then
    __tmux_session_fzf() {
        "${HOME}/.local/scripts/tmux-session-fzf"
    }

    bind -x '"\es":__tmux_session_fzf'
fi

##### SOURCE SHELL FILES #####
source "${HOME}/.shell/aliases.sh"
source "${HOME}/.shell/functions.sh"

{{- end }}

##### ATUIN #####
if command -v atuin &>/dev/null; then
    # Prefer the managed XDG config over Atuin's legacy ~/.atuin/config.toml.
    export ATUIN_CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/atuin"
    eval "$(atuin init bash --disable-ai --disable-up-arrow)"
fi
