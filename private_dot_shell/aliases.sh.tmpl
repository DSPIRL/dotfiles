# Only load aliases in interactive shells (prevents issues with Claude Code, scripts, etc.)
[[ $- != *i* ]] && return

##### SYSTEM #####
alias l='command ls --color=auto'
alias grep='grep --color=auto'
alias cls="clear"
alias modhelp="cat ${HOME}/.shell/manpages/help_chmod.md"
alias glols='git log --graph --pretty="%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%ar) %C(bold blue)<%an>%Creset" --stat'

if command -v eza >/dev/null 2>&1; then
    alias ls="eza -lhAF --color=auto --icons=always"
else
    alias ls="ls -lAFh --color=auto"
fi

if command -v zoxide >/dev/null 2>&1; then
    alias cd="z"
fi

{{- if eq .chezmoi.os "darwin" }}
alias modstat='stat -f "File name: %N
File type: %HT%SY
Exec modes: %Sp
Hex values: %Lp"'
{{- else }}
alias modstat='stat -c "File name: %n
File type: %F -> %N
Exec modes: %A
Hex values: %a"'
{{- end }}

##### EXIFTOOL #####
if command -v exiftool >/dev/null 2>&1; then
    alias exifall="exiftool -all="
    alias exifkeepicc="exiftool -all= --icc_profile:all"
fi

##### EDITOR #####
if command -v nvim >/dev/null 2>&1; then
    alias nv="nvim"
fi

##### OKTA #####
if command -v okta-aws-cli >/dev/null 2>&1; then
    alias okta='okta-aws-cli'
fi

##### CLAUDE #####
if command -v claude >/dev/null 2>&1; then
    alias claude-unsafe="claude --allow-dangerously-skip-permissions"
fi

##### CARGO #####
if [[ -d $HOME/.cargo ]]; then
    alias cr="cargo run"
    alias ct="cargo test"
    alias cb="cargo build"
fi

##### EMACS #####
if command -v emacsclient >/dev/null 2>&1; then
    alias emacs="emacsclient -c -a 'emacs'"
fi

{{- if eq .chezmoi.os "darwin" }}

##### PYTHON (macOS) #####
if command -v python3 >/dev/null 2>&1; then
    alias python="python3"
    alias pip="pip3"
fi

##### RUBY (macOS) #####
[[ -x /opt/homebrew/bin/ruby ]] && alias ruby="/opt/homebrew/bin/ruby"
{{- end }}
