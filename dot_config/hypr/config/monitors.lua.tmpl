-- Monitor layout with hot-plug (dock / undock) detection.
--
-- Hyprland's Lua config fires `monitor.added` / `monitor.removed`, so instead of
-- a static list of outputs we describe layouts and re-apply the matching one
-- whenever a display shows up or disappears.
--
-- Debugging helpers:
--   hyprctl monitors                          -- live outputs + descriptions
--   hyprctl output create headless            -- fake a hotplug
--   hyprctl output remove HEADLESS-1          -- fake an unplug
--   hyprctl repl 'return require("config.monitors").describe()'
--   SUPER + SHIFT + M                         -- re-apply the layout by hand

local M = {}

--- Show a Hyprland notification whenever the layout changes.
local NOTIFY = true

{{ if .chezmoi.hostname | contains "laptop" -}}
--- Built-in ThinkPad panel.
local PRIMARY = {
  output = "eDP-1",
  mode = "1920x1200@60.0",
  position = "0x0",
  scale = 1.0,
}

--- Layouts for known external displays. First match wins. `match` is compared
--- case-insensitively against the monitor description (substring) and against
--- the connector name (exact) -- see `hyprctl monitors`.
---
--- Per-entry fields:
---   external  HL.MonitorSpec bits applied to the external screen
---   primary   overrides merged into PRIMARY while this dock is active
---   clamshell disable the built-in panel when (and only when) its lid closes
local DOCKS = {
  {
    match = "Odyssey G93SC",
    external = { mode = "5120x1440@120.0", position = "0x0", scale = 1 },
    -- Keep the 1920px laptop panel centred underneath the ultrawide while open.
    primary = { position = "1600x1440" },
    clamshell = true,
  },
}
{{- else -}}
--- Desktop main display.
local PRIMARY = {
  output = "DP-1",
  mode = "5120x1440@240",
  position = "0x0",
  scale = 1,
}

local DOCKS = {}
{{- end }}

--- Used for any display we do not have a DOCKS entry for: native mode, placed
--- automatically to the right of everything else.
local FALLBACK = { mode = "preferred", position = "auto", scale = 1 }

-- The kernel updates this file on lid events. It is read once at config load;
-- subsequent state changes come directly from Hyprland switch bindings.
local LID_STATE_PATH = "/proc/acpi/button/lid/LID/state"
local lid_closed

local function read_lid_closed()
  local file = io.open(LID_STATE_PATH, "r")
  if not file then
    return false
  end
  local state = file:read("*a"):lower()
  file:close()
  return state:find("closed", 1, true) ~= nil
end

function M.is_lid_closed()
  if lid_closed == nil then
    lid_closed = read_lid_closed()
  end
  return lid_closed
end

--- Called by the native Hyprland Lid Switch bindings in keybinds.lua.
function M.set_lid_closed(closed)
  lid_closed = not not closed
  M.apply()
end

-- ---------------------------------------------------------------------------

local function notify(text)
  if not NOTIFY then
    return
  end
  pcall(function()
    hl.notification.create({ text = "[monitors] " .. text, timeout = 3000 })
  end)
end

local function merge(base, override)
  local out = {}
  for k, v in pairs(base or {}) do
    out[k] = v
  end
  for k, v in pairs(override or {}) do
    out[k] = v
  end
  return out
end

local function set_monitor(spec)
  local ok, err = pcall(hl.monitor, spec)
  if not ok then
    notify("failed for " .. tostring(spec.output) .. ": " .. tostring(err))
  end
  return ok
end

local function matches(mon, needle)
  needle = tostring(needle):lower()
  local name = (mon.name or ""):lower()
  local description = (mon.description or ""):lower()
  return name == needle or description:find(needle, 1, true) ~= nil
end

local function dock_for(mon)
  for _, dock in ipairs(DOCKS) do
    if matches(mon, dock.match) then
      return dock
    end
  end
  return nil
end

--- Every connected monitor that is not the built-in / main panel.
--- `ignore` is the output name of a monitor that is currently going away.
local function externals(ignore)
  local list = {}
  for _, mon in ipairs(hl.get_monitors() or {}) do
    if mon.name ~= PRIMARY.output and mon.name ~= ignore then
      list[#list + 1] = mon
    end
  end
  return list
end

-- Layout --------------------------------------------------------------------

--- Apply the layout that matches the currently connected displays.
--- @param ignore string|nil output name to treat as already disconnected
function M.apply(ignore)
  local ext = externals(ignore)

  if #ext == 0 then
    set_monitor(merge(PRIMARY, { disabled = false }))
    notify("undocked: " .. PRIMARY.output .. " only")
    return
  end

  -- First external display we have an explicit profile for wins.
  local dock
  for _, mon in ipairs(ext) do
    local candidate = dock_for(mon)
    if candidate and not dock then
      dock = candidate
    end
  end

  for _, mon in ipairs(ext) do
    local profile = dock_for(mon)
    set_monitor(merge({ output = mon.name, disabled = false }, profile and profile.external or FALLBACK))
  end

  if dock and dock.clamshell and M.is_lid_closed() then
    set_monitor({ output = PRIMARY.output, disabled = true })
  else
    set_monitor(merge(PRIMARY, merge({ position = "auto", disabled = false }, dock and dock.primary or {})))
  end

  local names = {}
  for _, mon in ipairs(ext) do
    names[#names + 1] = mon.name
  end
  notify("docked: " .. table.concat(names, ", ") .. (dock and (" (" .. dock.match .. ")") or " (generic)"))
end

--- Small debounce: a freshly plugged monitor needs a moment before its modes
--- and description are final, so re-apply shortly after the event too.
local timer
local function schedule(ignore)
  M.apply(ignore)
  timer = hl.timer(function()
    M.apply(ignore)
  end, { timeout = 400, type = "oneshot" })
end

--- Human readable dump of what Hyprland currently sees.
function M.describe()
  local lines = {}
  for _, mon in ipairs(hl.get_monitors() or {}) do
    lines[#lines + 1] = string.format(
      "%s | %s | %dx%d@%.2f at %d,%d | scale %.2f%s",
      mon.name,
      mon.description,
      mon.width,
      mon.height,
      mon.refresh_rate,
      mon.x,
      mon.y,
      mon.scale,
      dock_for(mon) and " | profile: " .. dock_for(mon).match or ""
    )
  end
  return table.concat(lines, "\n")
end

hl.on("monitor.added", function()
  schedule(nil)
end)

hl.on("monitor.removed", function(mon)
  schedule(mon and mon.name or nil)
end)

-- Apply once at config load / reload.
M.apply()

return M
