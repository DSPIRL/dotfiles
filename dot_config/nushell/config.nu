source ~/.config/nushell/env_config.nu
source ~/.config/nushell/user_config.nu
source ~/.config/nushell/keybinds.nu

# Cache files are generated in env.nu before this file is parsed
source ~/.zoxide.nu
source ~/.cache/carapace/init.nu
source ~/.cache/nushell/mise.nu

source ~/.config/nushell/okta-completions.nu
source ~/.config/nushell/alias.nu
source ~/.config/nushell/login.nu
source ~/.config/nushell/prompt.nu
