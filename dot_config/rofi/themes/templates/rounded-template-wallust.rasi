/* Quiet surfaces shared with the Quickshell controls. */
* {
    font: "Noto Sans 12";
    background-color: transparent;
    text-color: @normal-text;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}
window {
    location: center;
    width: 600px;
    border-radius: 18px;
    border: 1px;
    background-color: @window-background;
    border-color: @window-border;
}
mainbox { padding: 20px; }
inputbar {
    background-color: @scrollbar-empty;
    border-radius: 10px;
    spacing: 8px;
    children: [ entry ];
}
entry {
    expand: true;
    placeholder: "Search…";
    placeholder-color: @normal-text;
    padding: 12px;
}
message { margin: 12px 0 0; border-radius: 10px; }
textbox { padding: 8px 12px; }
listview {
    margin: 12px 0 0;
    lines: 8;
    columns: 1;
    fixed-height: false;
    scrollbar: true;
}
scrollbar { width: 3px; background-color: @scrollbar-empty; handle-color: @scrollbar-filled; }
element { padding: 10px 12px; margin: 2px 0; spacing: 10px; border-radius: 10px; }
element selected normal, element selected active {
    background-color: @selected-background;
    text-color: @selected-text;
}
element-icon { size: 1.3em; vertical-align: 0.5; }
element-text { vertical-align: 0.5; text-color: inherit; }
