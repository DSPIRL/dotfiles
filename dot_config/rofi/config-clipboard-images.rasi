@import "~/.config/rofi/grid.rasi"

mainbox {
  children: [ "inputbar", "message", "listview"];
}

entry {
  placeholder: " 🖼 Clipboard Images ";
}

listview {
  columns: 3;
  lines: 3;
}

window {
    width: calc(95% min 850px);
}

@media (max-width: 760px) {
    listview { columns: 2; }
}
@media (max-height: 900px) {
    listview { lines: 2; }
}
@media (max-height: 650px) {
    listview { lines: 1; }
}

element {
    padding: 5px;
    margin: 2px;
}

element-icon {
    size: 200px;
    background-color: transparent;
}

element-text {
    enabled: false;
}
