@import "~/.config/rofi/config.rasi" 

/* Rofi measures grid rows from the window font, not just element-text. */
window { font: @emoji-font; }
entry { font: @text-font; }

textbox {
    font: @text-font;
    vertical-align:   0.5;
    horizontal-align: 0.5;
}

listview {
    columns:       5;
    lines:         4;
    cycle:         true;
    dynamic:       true;
    layout:        vertical;
    flow:          horizontal;
    reverse:       false;
    fixed-height:  true;
    fixed-columns: true;
}

element {
    orientation: vertical;
    padding: 18px 24px;
}

element-text {
    font: @emoji-font;
    vertical-align:   0.5;
    horizontal-align: 0.5;
}
