* {
    accent: {{color12}};
    selected-text: #F4F6FC;
    selected-background: {{color12}}38;
    selected-border: {{color12}}66;
    normal-text: #F4F6FC;
    muted-text: #C2CADB;
    normal-background: transparent;
    prompt-text: #C2CADB;
    prompt-background: transparent;
    window-border: #FFFFFF38;
    window-background: #30374666;
    window-bottom: #1A202C66;
    window-image: linear-gradient(to bottom, #30374666, #1A202C66);
    surface-background: #29314080;
    surface-border: #FFFFFF18;
    scrollbar-filled: {{color12}};
    scrollbar-empty: #A1B0CB24;
    error-message: #FF9CAA;
    error-message-border: #FF9CAA;
}
