[general]
framerate = 120
bars = 120
bar_width = 1
bar_spacing = 1
lower_cutoff_freq = 50
higher_cutoff_freq = 4500

[input]
{{- if ne .chezmoi.os "darwin" }}
method = portaudio
{{- end }}
method = pipewire
source = auto

[output]
{{- if ne .chezmoi.os "linux" }}
method = noncurses
{{- end }}
channels = stereo
orientation = bottom
reverse = 1
waveform = 0

[color]
background = 'default'
gradient = 1

gradient = 1
gradient_count = 8
{{ $open := "{{" -}}
{{ $close := "}}" -}}
gradient_color_1 = '{{$open}}color0{{$close}}'
gradient_color_2 = '{{$open}}color2{{$close}}'
gradient_color_3 = '{{$open}}color3{{$close}}'
gradient_color_4 = '{{$open}}color5{{$close}}'
gradient_color_5 = '{{$open}}color7{{$close}}'
gradient_color_6 = '{{$open}}color12{{$close}}'
gradient_color_7 = '{{$open}}color13{{$close}}'
gradient_color_8 = '{{$open}}color15{{$close}}'

[smoothing]
monstercat = 1
noise_reduction = 50

[eq]
