##### FUNCTIONS #####
function ref_dirinfo
    set -l dir .
    if test (count $argv) -gt 0
        set dir $argv[1]
    end

    echo 'File count:'
    find "$dir" -type f | wc -l
    echo 'Total size (GiB):'
    find "$dir" -type f -printf '%s\n' | awk '{total += $1} END {printf "%.2f GB\n", total/1024/1024/1024}'
end

function ref_dirinfo2
    set -l dir .
    if test (count $argv) -gt 0
        set dir $argv[1]
    end

    echo "File count:  "(find "$dir" -type f | wc -l)
    echo "Total size: "(find "$dir" -type f -print0 | du --files0-from=- -ch | tail -n1)
end

function mp4togif
    if test (count $argv) -lt 1
        echo 'Usage: mp4togif INPUT [FPS] [WIDTH] [DITHER]' >&2
        return 2
    end

    set -l input $argv[1]
    set -l fps 15
    set -l width 720
    set -l dither bayer

    test (count $argv) -ge 2; and set fps $argv[2]
    test (count $argv) -ge 3; and set width $argv[3]
    test (count $argv) -ge 4; and set dither $argv[4]

    set -l output (string replace -r '\.mp4$' '.gif' -- "$input")
    if test "$output" = "$input"
        set output "$input.gif"
    end

    ffmpeg -i "$input" \
        -vf "fps=$fps,scale=$width:-1:flags=lanczos,split[s0][s1];[s0]palettegen=max_colors=256[p];[s1][p]paletteuse=dither=$dither" \
        "$output"
end

