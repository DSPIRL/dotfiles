##### PROMPT #####
if command -q oh-my-posh; and test "$TERM_PROGRAM" != Apple_Terminal
    function __init_oh_my_posh
        set -l omp_config "$HOME/.config/oh-my-posh/wallust.omp.json"
        if test -f "$omp_config"
            oh-my-posh init fish --config "$omp_config" | source
        else
            oh-my-posh init fish | source
        end
    end

    function __wallust_prompt_refresh_pidfile
        if set -q XDG_RUNTIME_DIR; and test -d "$XDG_RUNTIME_DIR"; and test -w "$XDG_RUNTIME_DIR"
            echo "$XDG_RUNTIME_DIR/wallust-prompt-refresh.fish.pids"
            return
        end

        set -l runtime_dir "/run/user/"(id -u)
        if not test -d "$runtime_dir"; or not test -w "$runtime_dir"
            set runtime_dir "$HOME/.cache"
        end

        echo "$runtime_dir/wallust-prompt-refresh.fish.pids"
    end

    function __wallust_prompt_refresh_state
        set -l stat_file "/proc/$fish_pid/stat"
        test -r "$stat_file"; or return

        set -l stat (cat "$stat_file")
        set -l rest (string replace -r '^.*\) ' '' -- "$stat")
        set -l stat_fields (string split ' ' -- "$rest")
        test (count $stat_fields) -ge 20; and echo $stat_fields[20]
    end

    function __wallust_prompt_refresh_register
        set -l pid_file (__wallust_prompt_refresh_pidfile)
        set -l pid_dir (dirname "$pid_file")
        mkdir -p "$pid_dir" 2>/dev/null; or return

        set -l tmp_file "$pid_file.$fish_pid"
        if test -f "$pid_file"
            while read -l line
                string match -qr "^$fish_pid( |\$)" -- "$line"; and continue
                printf '%s\n' "$line"
            end <"$pid_file" >"$tmp_file"
            mv "$tmp_file" "$pid_file" 2>/dev/null; or begin
                rm -f "$tmp_file"
                return
            end
        end

        printf '%s %s\n' "$fish_pid" (__wallust_prompt_refresh_state) >>"$pid_file"
    end

    function __wallust_prompt_refresh_unregister --on-event fish_exit
        set -l pid_file (__wallust_prompt_refresh_pidfile)
        test -f "$pid_file"; or return

        set -l tmp_file "$pid_file.$fish_pid"
        while read -l line
            string match -qr "^$fish_pid( |\$)" -- "$line"; and continue
            printf '%s\n' "$line"
        end <"$pid_file" >"$tmp_file"
        mv "$tmp_file" "$pid_file" 2>/dev/null; or rm -f "$tmp_file"
    end

    function __wallust_prompt_refresh_prompt --on-signal SIGUSR2
        __init_oh_my_posh
        set --global _omp_new_prompt 1
        if functions -q omp_repaint_prompt
            omp_repaint_prompt 2>/dev/null; or commandline --function repaint 2>/dev/null
        else
            commandline --function repaint 2>/dev/null
        end
    end

    __init_oh_my_posh
    __wallust_prompt_refresh_register
end

