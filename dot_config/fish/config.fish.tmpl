function __add_path --argument-names path position
    test -d "$path"; or return

    if contains -- "$path" $PATH
        set -gx PATH (string match -v -- "$path" $PATH)
    end

    if test "$position" = append
        set -gx PATH $PATH "$path"
    else
        set -gx PATH "$path" $PATH
    end
end

