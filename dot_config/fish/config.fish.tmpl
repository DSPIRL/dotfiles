##### FZF #####
if command -q fzf
    set -gx FZF_DEFAULT_OPTS_FILE "$HOME/.config/fzf/.fzfrc"
    set -gx FZF_CTRL_T_COMMAND "fd --hidden --ignore-case"
    set -gx FZF_CTRL_T_OPTS "--preview='less {}' --bind shift-up:preview-page-up,shift-down:preview-page-down"
    set -gx FZF_ALT_C_COMMAND ""
    fzf --fish | source

    function __fzf_path_widget
        set -l line (commandline)
        set -l cursor (commandline -C)
        set -l before ""
        set -l after ""

        if test "$cursor" -gt 0
            set before (string sub -s 1 -l "$cursor" -- "$line")
        end
        set after (string sub -s (math "$cursor" + 1) -- "$line")

        set -l token (string replace -r '^.*[[:space:]]' '' -- "$before")
        set -l prefix_len (math (string length -- "$before") - (string length -- "$token"))
        set -l prefix ""
        if test "$prefix_len" -gt 0
            set prefix (string sub -s 1 -l "$prefix_len" -- "$before")
        end

        set -l selected ("$HOME/.local/scripts/fzf-path-widget" "$token")
        or return
        test (count $selected) -gt 0; or return

        set -l quoted
        for selection in $selected
            set -a quoted (string escape -- "$selection")
        end

        set -l replacement (string join ' ' -- $quoted)
        commandline -r "$prefix$replacement$after"
        commandline -C (math (string length -- "$prefix") + (string length -- "$replacement"))
    end
end

