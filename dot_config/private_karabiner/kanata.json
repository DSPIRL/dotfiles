              {
                "type": "basic",
                "from": {
                  "key_code": "right_command",
                  "modifiers": { "optional": ["any"] }
                },
                "to_if_alone": [
                  {
                    "set_variable": {
                      "name": "dvorak_mode",
                      "value": 0
