                "type": "basic",
                "from": {
                  "key_code": "right_command",
                  "modifiers": { "optional": ["any"] }
                },
                "to_if_alone": [
                  {
                    "set_variable": {
                      "name": "dvorak_mode",
                      "value": 1
                    }
                  },
                  {
                    "set_notification_message": {
                      "id": "layout_switch",
                      "text": "Dvorak Mode"
                    }
                  }
                ],
                "to": [{ "key_code": "right_command" }],
                "conditions": [
                  {
                    "type": "variable_if",
                    "name": "dvorak_mode",
                    "value": 0
                  }
                ]
