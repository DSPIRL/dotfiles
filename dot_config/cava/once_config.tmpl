[general]
framerate = 120
bars = 120
bar_width = 1
bar_spacing = 1
lower_cutoff_freq = 50
higher_cutoff_freq = 4500

[input]
{{- if ne .chezmoi.os "darwin" }}
method = portaudio
{{- end }}
method = pipewire
source = auto

[output]
{{- if ne .chezmoi.os "linux" }}
method = noncurses
{{- end }}
channels = stereo
orientation = bottom
reverse = 1
waveform = 0

[color]
background = 'default'
gradient = 1
# foreground = '#33ffff'
gradient_color_1 = '#59cc33'
gradient_color_2 = '#80cc33'
gradient_color_3 = '#a6cc33'
gradient_color_4 = '#cccc33'
gradient_color_5 = '#cca633'
gradient_color_6 = '#cc8033'
gradient_color_7 = '#cc5933'
gradient_color_8 = '#cc3333'

[smoothing]
monstercat = 1
noise_reduction = 50

[eq]
