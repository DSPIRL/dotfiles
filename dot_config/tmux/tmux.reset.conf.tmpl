# Set terminal colors
set-option -g default-terminal 'screen-256color'
set-option -g terminal-overrides ',xterm-256color:RGB'

set -as terminal-features ',xterm*:RGB,alacritty*:RGB,wezterm*:RGB'

# Catppuccin Mocha palette (hand-rolled, no plugin)
# crust #11111b  surface0 #313244  overlay0 #6c7086  text #cdd6f4
# mauve #cba6f7  green #a6e3a1     blue #89b4fa

# Status bar: rounded catppuccin "pills"
set -g status on
set -g status-interval 10
set -g status-justify absolute-centre
set -g status-style 'bg=default,fg=#cdd6f4'
set -g status-left-length 60
set -g status-right-length 60
set -g message-style 'bg=#313244,fg=#cdd6f4'
set -g mode-style 'bg=#45475a,fg=#cdd6f4'

set -g window-status-separator ' '
set -g window-status-format '#[fg=#6c7086]#[fg=#11111b,bg=#6c7086]#I #[fg=#cdd6f4,bg=#313244] #W#[fg=#313244,bg=default]'
set -g window-status-current-format '#[fg=#cba6f7]#[fg=#11111b,bg=#cba6f7,bold]#I #[fg=#cdd6f4,bg=#313244,nobold] #W#{?window_zoomed_flag, 󰁌,}#[fg=#313244,bg=default]'

{{- if eq .chezmoi.os "darwin" }}
set -g status-left '#[fg=#a6e3a1]#[fg=#11111b,bg=#a6e3a1]󰁹 #[fg=#cdd6f4,bg=#313244] #(~/.local/scripts/tmux-battery)#[fg=#313244,bg=default]'
{{- else }}
set -g status-left ''
{{- end }}
set -g status-right '#[fg=#89b4fa]#[fg=#11111b,bg=#89b4fa]󰃰 #[fg=#cdd6f4,bg=#313244] %a %d %H:%M#[fg=#313244,bg=default]'

# Pane borders: heavy lines, a title strip on top of every pane, mauve for
# the active one. The top strip means the active pane is outlined even when
# it touches the edge of the screen.
set -g pane-border-lines heavy
set -g pane-border-indicators both
set -g pane-border-status top
set -g pane-border-style 'fg=#313244,bg=default'
set -g pane-active-border-style 'fg=#cba6f7,bg=default'
set -g pane-border-format '#{?pane_active,#[fg=#11111b]#[bg=#cba6f7]#[bold],#[fg=#6c7086]} #P #{pane_current_command} '

# Improve pane splitting shortcuts
# unbind '"'
# unbind %
# bind | split-window -h
# bind - split-window -v

# Easier pane navigation
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R
bind -r C-h select-pane -L
bind -r C-j select-pane -D
bind -r C-k select-pane -U
bind -r C-l select-pane -R
bind -r M-h select-window -p
bind -r M-l select-window -n

# Easier window handling

# Resize panes with arrow keys
bind -r M-Left resize-pane -L 5
bind -r M-Right resize-pane -R 5
bind -r M-Up resize-pane -U 5
bind -r M-Down resize-pane -D 5

# Reload config with prefix + r
bind r source-file ~/.config/tmux/tmux.conf \; display "Reloaded!"

# Simplify prefix key (optional)
unbind C-b
set-option -g prefix C-a
bind C-a send-prefix

# Better VI
bind-key -T copy-mode-vi 'v' send-keys -X begin-selection
bind-key -T copy-mode-vi 'y' send-keys -X copy-selection-and-cancel
