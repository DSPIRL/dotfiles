{{- $isLinux := eq .chezmoi.os "linux" -}}
{{- $isMacOS := eq .chezmoi.os "darwin" -}}
{{- $isWSL := and $isLinux (contains "microsoft" (lower .chezmoi.kernel.osrelease)) -}}
{{- $isCachyOS := and $isLinux (eq (dig "id" "" .chezmoi.osRelease) "cachyos") -}}
{{- $hasHyprland := or (lookPath "Hyprland") (lookPath "hyprctl") | not | not -}}
{{- $hasFish := lookPath "fish" | not | not -}}
{{- $machineType := "work" -}}
{{- if not $isWSL -}}
{{- $machineType = promptChoiceOnce . "machineType" "Machine type" (list "personal" "work") "work" -}}
{{- end -}}
{{- $isPersonalMachine := eq $machineType "personal" -}}
{{- $keepassDB := joinPath .chezmoi.homeDir "Documents/Syncs/KeePass/Databases/Passwords/Passwords.kdbx" -}}
{{- $useKeePassXC := and $isPersonalMachine (stat $keepassDB) | not | not -}}

{{ if $useKeePassXC -}}
encryption = "age"
{{ end }}

[data]
    # Machine policy: chosen once at init; WSL is always work.
    machineType = {{ $machineType | quote }}
    isPersonalMachine = {{ $isPersonalMachine }}

    # Detected facts: rerun chezmoi init after installing/removing software.
    isLinux = {{ $isLinux }}
    isMacOS = {{ $isMacOS }}
    isWSL = {{ $isWSL }}
    isCachyOS = {{ $isCachyOS }}
    hasHyprland = {{ $hasHyprland }}
    hasFish = {{ $hasFish }}

    # Secret access is separate from personal/work classification.
    useKeePassXC = {{ $useKeePassXC }}

{{ if $useKeePassXC }}
[age]
    identity = "~/.config/chezmoi/key.txt"
    recipient = "age1u8jpuvpt70q406l9j289jm8ayvn6ktmu67r8qru40492zkx4gufqfy6qwj"

[keepassxc]
    database = {{ $keepassDB | quote }}
{{ end }}
