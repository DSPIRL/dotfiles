# Conditions below use [data] values generated by .chezmoi.toml.tmpl.
# Rerun chezmoi init after changing machine policy or installed software.
# Exclusions are cumulative; later sections do not override earlier ones.

# Always ignored

# macOS metadata (never deployed)
.DS_Store

# Auxiliary directories (not deployed to ~)
docs/
install_scripts/
package_lists/
tests/

# Non-deployed shell files and subdirs
.shell/.git-submodule-aliases.sh
.shell/dink.sh
.shell/kdeshortcuts.kksrc
.shell/manpages/
.shell/scripts/

# Git/Stow artifacts
.git
.gitignore
.stow-local-ignore
*.md

# Nushell sqlite
*/nushell/history.sqlite3*

# Neovim plugin lockfile (machine-specific)
.config/nvim/lazy-lock.json

# Podman connections (machine-specific)
.config/containers/podman-connections.json

# Herdr runtime state (logs, sockets, session snapshots) lives in the same
# directory as its config; only config.toml and status.sh are managed.
.config/herdr/*.log
.config/herdr/*.sock
.config/herdr/session.json
.config/herdr/session-history.json
.config/herdr/.plugins.lock

# Machine policy and secrets

# If this is not a personal machine, ignore these personal-only configs.
{{ if not .isPersonalMachine }}
.config/containers/
.config/chezmoi/
.config/nvim/lua/plugins/opencode.lua
.ssh/
{{ end }}

# If KeePassXC integration is disabled, ignore the chezmoi key config so an
# existing age key cannot be overwritten with an empty key.
{{ if not .useKeePassXC }}
.config/chezmoi/
{{ end }}

# Platform restrictions

# If this machine does not run macOS, ignore these macOS-only configs and helpers.
# On macOS, app installation is not required to manage these files.
{{ if not .isMacOS }}
.config/aerospace/
.config/kanata/mac_config.kbd
.config/kanata/start_kanata.sh
.config/karabiner/
.config/nushell/scripts/mac-kanata.nu
{{ end }}

# Linux-only configs and helpers that do not require Hyprland.
# If this machine does not run Linux, ignore the following files.
{{ if not .isLinux }}
.config/.dmenurc
.config/cava/
.config/cliphist/
.config/dconf/
.config/dot_dmenurc
.config/environment.d
.config/kanata/config.kbd
.config/kanata/config-hand-locked.kbd
.config/kanata/config.kbd.backup
.config/kcminputrc
.config/kdeglobals
.config/nushell/scripts/flatpak-alias.nu
.config/nushell/scripts/modstat.nu
.config/nwg-look/
.config/qt5ct/
.config/qt6ct/
.config/swaylock/
.config/swaync/
.config/systemd
.config/wal/
.config/waypaper/
.config/wlogout/
.config/xdg-desktop-portal/
.config/xsettingsd/
.local/scripts/cliphist-rofi
.local/scripts/cliphist-rofi-img
.local/scripts/flatpak-alias
.local/scripts/setmpv
.local/scripts/setwal
.local/scripts/startResolve
{{ end }}

# WSL has no Linux desktop/GUI or clipboard support in this setup.
# Personal/work policy is handled separately above.
# If this machine is WSL, ignore these GUI, desktop, and clipboard files.
{{ if .isWSL }}
.config/.dmenurc
.config/cava/
.config/cliphist/
.config/dconf/
.config/dot_dmenurc
.config/kanata/
.config/nvim/lua/plugins/silicon.lua
.config/nwg-look/
.config/qt5ct/
.config/qt6ct/
.config/swaylock/
.config/swaync/
.config/wal/
.config/waypaper/
.config/wlogout/
.config/xdg-desktop-portal/
.config/xsettingsd/
.local/scripts/cliphist-rofi
.local/scripts/cliphist-rofi-img
.local/scripts/setmpv
.local/scripts/setwal
.local/scripts/startResolve
{{ end }}

# Installed capabilities

# Hyprland desktop and theme configs. Hyprland implies Linux.
# WSL stays headless even if Hyprland happens to be installed.
# Add further Hyprland-specific paths here as needed.
# If Hyprland is absent, or this machine is WSL, ignore this desktop/theme bundle.
{{ if or (not .hasHyprland) .isWSL }}
.config/Kvantum/
.config/alacritty/colors.toml
.config/ghostty/themes/wallust.conf
.config/gtk-3.0/
.config/gtk-4.0/
.config/gtkrc
.config/gtkrc-2.0
.config/hypr/
.config/mimeapps.list
.config/ncspot/colors.toml
.config/oh-my-posh/wallust.omp.json
.config/quickshell/
.config/rofi/
.config/swaync/wallust/
.config/systemd/user/hyprland-session.target
.config/walli/
.config/wallust/
.config/wezterm/theme.lua
.gtkrc-2.0
.local/scripts/wallust-refresh
{{ end }}

# If this machine does not run Linux, or Fish is absent, ignore the Fish config.
{{ if or (not .isLinux) (not .hasFish) }}
.config/fish/
{{ end }}

