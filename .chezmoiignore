# Conditions below use [data] values generated by .chezmoi.toml.tmpl.
# Rerun chezmoi init after changing machine policy or installed software.

# TODO: revisit this temporary CachyOS debugging workaround.
# Commented paths are retained as debugging toggles for later review.
{{ if .isCachyOS }}
# .bash_profile
# .bashrc
.config/.dmenurc
.config/Kvantum/
# .config/cliphist/
.config/gtkrc-2.0
# .config/hypr/
# .config/quickshell/
# .config/rofi/
# .config/swaylock/
# .config/swaync/
# .config/wallust/
# .config/waypaper/
# .profile
# .zshenv
# .zshrc
{{ end }}

# macOS metadata (never deployed)
.DS_Store

# Auxiliary directories (not deployed to ~)
docs/
install_scripts/
package_lists/

# Non-deployed shell subdirs
private_dot_shell/.git-submodule-aliases.sh
private_dot_shell/dink.sh
private_dot_shell/kdeshortcuts.kksrc
private_dot_shell/manpages/
private_dot_shell/scripts/

# Git/Stow artifacts
.git
.gitignore
.stow-local-ignore
*.md

# Nushell sqlite
*/nushell/history.sqlite3*

# Neovim plugin lockfile (machine-specific)
.config/nvim/lazy-lock.json

# Podman connections (machine-specific)
.config/containers/podman-connections.json

# Herdr runtime state (logs, sockets, session snapshots) lives in the same
# directory as its config; only config.toml and status.sh are managed.
.config/herdr/*.log
.config/herdr/*.sock
.config/herdr/session.json
.config/herdr/session-history.json
.config/herdr/.plugins.lock

# Personal-only configs: work machines must not receive these.
{{ if not .isPersonalMachine }}
.config/containers/
.config/chezmoi/
.config/nvim/lua/plugins/opencode.lua
.ssh/
{{ end }}

# Never render an empty age key when the password database is unavailable.
{{ if not .useKeePassXC }}
.config/chezmoi/
{{ end }}

# macOS-only configs; app installation is not required.
{{ if not .isMacOS }}
.config/aerospace/
.config/karabiner/
{{ end }}

# Hyprland desktop and theme configs. Hyprland implies Linux.
# WSL stays headless even if Hyprland happens to be installed.
# Add further Hyprland-specific paths here as needed.
{{ if or (not .hasHyprland) .isWSL }}
.config/Kvantum/
.config/alacritty/colors.toml
.config/ghostty/themes/wallust.conf
.config/gtk-3.0/
.config/gtk-4.0/
.config/gtkrc
.config/gtkrc-2.0
.config/hypr/
.config/mimeapps.list
.config/ncspot/colors.toml
.config/oh-my-posh/wallust.omp.json
.config/quickshell/
.config/rofi/
.config/swaync/wallust/
.config/systemd/user/hyprland-session.target
.config/walli/
.config/wallust/
.config/wezterm/theme.lua
.gtkrc-2.0
{{ end }}

# WSL has no Linux desktop/GUI or clipboard support in this setup.
