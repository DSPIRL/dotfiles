#!/usr/bin/env sh

set -eu

tmp="$(mktemp)"
cat >"$tmp"
if [ -s "$tmp" ]; then
  jq '.statusLine.type = "command" | .statusLine.command = "sh $HOME/.claude/statusline-command.sh"' <"$tmp"
else
  jq -n '.statusLine.type = "command" | .statusLine.command = "sh $HOME/.claude/statusline-command.sh"'
fi
rm -f "$tmp"
